    classDef leaf2 fill:#b83b5e,color:#fff,stroke:#f08a5d,stroke-width:1px,font-size:11px
    classDef legend fill:#1a1a2e,color:#fff,stroke:#f08a5d,stroke-width:2px,font-size:12px
    
